@model IEnumerable<StudentAdminPortal.Models.Student>

@{
    ViewBag.Title = "Students";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Student Management</h2>
            <p class="text-muted mb-0">
                Manage all registered students
            </p>
        </div>

        <a href="@Url.Action("Create", "Student")"
           class="btn btn-primary">
            + Add Student
        </a>

    </div>


    <!-- Statistics -->
    <div class="row mb-4">

        <div class="col-md-4">

            <div class="dashboard-card">

                <div class="text-muted">
                    Total Students
                </div>

                <h2 class="fw-bold">
                    @ViewBag.TotalStudents
                </h2>

            </div>

        </div>

        <div class="col-md-4">

            <div class="dashboard-card">

                <div class="text-muted">
                    Active Students
                </div>

                <h2 class="fw-bold text-success">
                    @Model.Count(s => s.Status)
                </h2>

            </div>

        </div>

        <div class="col-md-4">

            <div class="dashboard-card">

                <div class="text-muted">
                    Inactive Students
                </div>

                <h2 class="fw-bold text-danger">
                    @Model.Count(s => !s.Status)
                </h2>

            </div>

        </div>

    </div>


    <!-- Search -->
    <div class="dashboard-card">

        <form method="get"
              action="@Url.Action("Index", "Student")">

            <div class="row">

                <div class="col-md-10">

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Search by name, enrollment number or email..." />

                </div>

                <div class="col-md-2">

                    <button type="submit"
                            class="btn btn-dark w-100">
                        🔍 Search
                    </button>

                </div>

            </div>

        </form>

    </div>


    <!-- Student Table -->
    <div class="dashboard-card">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-dark">

                    <tr>

                        <th>Enrollment</th>

                        <th>Student Name</th>

                        <th>Email</th>

                        <th>Phone</th>

                        <th>Course</th>

                        <th>Semester</th>

                        <th>Status</th>

                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center text-muted py-4">

                                No students found.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.EnrollmentNo
                                    </strong>
                                </td>

                                <td>
                                    @item.FirstName @item.LastName
                                </td>

                                <td>
                                    @item.Email
                                </td>

                                <td>
                                    @item.Phone
                                </td>

                                <td>
                                    @(item.Course != null
                                        ? item.Course.CourseName
                                        : "N/A")
                                </td>

                                <td>
                                    @item.Semester
                                </td>

                                <td>

                                    @if (item.Status)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a href="@Url.Action("Details", "Student",
                                        new { id = item.StudentId })"
                                       class="btn btn-sm btn-outline-info">
                                        View
                                    </a>

                                    <a href="@Url.Action("Edit", "Student",
                                        new { id = item.StudentId })"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a href="@Url.Action("Delete", "Student",
                                        new { id = item.StudentId })"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>