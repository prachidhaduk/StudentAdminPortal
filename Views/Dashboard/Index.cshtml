@model IEnumerable<StudentAdminPortal.Models.Student>

@{
    ViewBag.Title = "Dashboard";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Student Admin Dashboard</h2>
            <p class="text-muted">
                Welcome to Student Admin Portal
            </p>
        </div>

        <a href="@Url.Action("Create", "Student")"
           class="btn btn-primary">
            + Add Student
        </a>
    </div>


    <!-- Statistics Cards -->

    <div class="row">

        <!-- Students -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h6 class="text-muted">
                        Total Students
                    </h6>

                    <h2>
                        @ViewBag.TotalStudents
                    </h2>

                    <a href="@Url.Action("Index", "Student")">
                        View Students →
                    </a>

                </div>
            </div>
        </div>


        <!-- Courses -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h6 class="text-muted">
                        Total Courses
                    </h6>

                    <h2>
                        @ViewBag.TotalCourses
                    </h2>

                    <a href="@Url.Action("Index", "Course")">
                        View Courses →
                    </a>

                </div>
            </div>
        </div>


        <!-- Subjects -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h6 class="text-muted">
                        Total Subjects
                    </h6>

                    <h2>
                        @ViewBag.TotalSubjects
                    </h2>

                    <a href="@Url.Action("Index", "Subject")">
                        View Subjects →
                    </a>

                </div>
            </div>
        </div>


        <!-- Attendance -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h6 class="text-muted">
                        Attendance Records
                    </h6>

                    <h2>
                        @ViewBag.TotalAttendance
                    </h2>

                    <a href="@Url.Action("Index", "Attendance")">
                        View Attendance →
                    </a>

                </div>
            </div>
        </div>

    </div>


    <!-- Attendance Summary -->

    <div class="row">

        <div class="col-md-6 mb-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <h5 class="card-title">
                        Attendance Summary
                    </h5>

                    <hr />

                    <div class="row text-center">

                        <div class="col-6">

                            <h2>
                                @ViewBag.PresentCount
                            </h2>

                            <p class="text-success">
                                Present
                            </p>

                        </div>

                        <div class="col-6">

                            <h2>
                                @ViewBag.AbsentCount
                            </h2>

                            <p class="text-danger">
                                Absent
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Quick Actions -->

        <div class="col-md-6 mb-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <h5 class="card-title">
                        Quick Actions
                    </h5>

                    <hr />

                    <div class="d-grid gap-2">

                        <a href="@Url.Action("Create", "Student")"
                           class="btn btn-primary">
                            Add New Student
                        </a>

                        <a href="@Url.Action("Create", "Course")"
                           class="btn btn-outline-primary">
                            Add New Course
                        </a>

                        <a href="@Url.Action("Create", "Subject")"
                           class="btn btn-outline-primary">
                            Add New Subject
                        </a>

                        <a href="@Url.Action("Create", "Attendance")"
                           class="btn btn-outline-success">
                            Mark Attendance
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Recent Students -->

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="d-flex justify-content-between">

                <h5 class="card-title">
                    Recent Students
                </h5>

                <a href="@Url.Action("Index", "Student")">
                    View All
                </a>

            </div>

            <hr />

            <div class="table-responsive">

                <table class="table table-hover">

                    <thead>

                        <tr>
                            <th>Enrollment No</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Email</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var student in Model)
                        {
                            <tr>

                                <td>
                                    @student.EnrollmentNo
                                </td>

                                <td>
                                    @student.FirstName
                                </td>

                                <td>
                                    @student.LastName
                                </td>

                                <td>
                                    @student.Email
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>