@model IEnumerable<StudentAdminPortal.Models.Mark>

@{
    ViewBag.Title = "Marks";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Marks Management
            </h2>

            <p class="text-muted mb-0">
                Manage student examination marks
            </p>
        </div>

        <a href="@Url.Action("Create", "Mark")"
           class="btn btn-primary">
            + Add Marks
        </a>

    </div>


    <div class="dashboard-card">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-dark">

                    <tr>
                        <th>Student</th>
                        <th>Subject</th>
                        <th>Internal</th>
                        <th>External</th>
                        <th>Total</th>
                        <th>Percentage</th>
                        <th>Grade</th>
                        <th>Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8"
                                class="text-center text-muted py-4">

                                No marks found.

                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.Student.FirstName
                                        @item.Student.LastName
                                    </strong>
                                </td>

                                <td>
                                    @item.Subject.SubjectName
                                </td>

                                <td>
                                    @item.InternalMarks / 40
                                </td>

                                <td>
                                    @item.ExternalMarks / 60
                                </td>

                                <td>
                                    <strong>
                                        @item.TotalMarks / 100
                                    </strong>
                                </td>

                                <td>
                                    @item.Percentage%
                                </td>

                                <td>

                                    @if (item.Grade == "F")
                                    {
                                        <span class="badge bg-danger">
                                            @item.Grade
                                        </span>
                                    }
                                    else if (item.Grade == "A+" ||
                                             item.Grade == "A")
                                    {
                                        <span class="badge bg-success">
                                            @item.Grade
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">
                                            @item.Grade
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a href="@Url.Action(
                                        "Details",
                                        "Mark",
                                        new { id = item.MarkId })"
                                       class="btn btn-sm btn-outline-info">
                                        View
                                    </a>

                                    <a href="@Url.Action(
                                        "Edit",
                                        "Mark",
                                        new { id = item.MarkId })"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a href="@Url.Action(
                                        "Delete",
                                        "Mark",
                                        new { id = item.MarkId })"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>