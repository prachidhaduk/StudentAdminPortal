@model StudentAdminPortal.Models.Mark

@{
    ViewBag.Title = "Add Marks";
}

<div class="container">

    <h2 class="mb-4">Add Student Marks</h2>

    @using (Html.BeginForm("Create", "Mark", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(
            true,
            "",
            new { @class = "text-danger" }
        )

        <div class="mb-3">
            @Html.LabelFor(
                model => model.StudentId,
                "Student",
                new { @class = "form-label" }
            )

            @Html.DropDownList(
                "StudentId",
                null,
                "-- Select Student --",
                new { @class = "form-select" }
            )

            @Html.ValidationMessageFor(
                model => model.StudentId,
                "",
                new { @class = "text-danger" }
            )
        </div>


        <div class="mb-3">
            @Html.LabelFor(
                model => model.SubjectId,
                "Subject",
                new { @class = "form-label" }
            )

            @Html.DropDownList(
                "SubjectId",
                null,
                "-- Select Subject --",
                new { @class = "form-select" }
            )

            @Html.ValidationMessageFor(
                model => model.SubjectId,
                "",
                new { @class = "text-danger" }
            )
        </div>


        <div class="mb-3">
            @Html.LabelFor(
                model => model.InternalMarks,
                new { @class = "form-label" }
            )

            @Html.TextBoxFor(
                model => model.InternalMarks,
                new
                {
                    @class = "form-control",
                    type = "number",
                    min = "0",
                    max = "40"
                }
            )

            <small class="text-muted">
                Maximum: 40
            </small>

            @Html.ValidationMessageFor(
                model => model.InternalMarks,
                "",
                new { @class = "text-danger" }
            )
        </div>


        <div class="mb-3">
            @Html.LabelFor(
                model => model.ExternalMarks,
                new { @class = "form-label" }
            )

            @Html.TextBoxFor(
                model => model.ExternalMarks,
                new
                {
                    @class = "form-control",
                    type = "number",
                    min = "0",
                    max = "60"
                }
            )

            <small class="text-muted">
                Maximum: 60
            </small>

            @Html.ValidationMessageFor(
                model => model.ExternalMarks,
                "",
                new { @class = "text-danger" }
            )
        </div>


        <button type="submit" class="btn btn-primary">
            Save Marks
        </button>

        <a href="@Url.Action("Index", "Mark")"
           class="btn btn-secondary">
            Cancel
        </a>
    }

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}