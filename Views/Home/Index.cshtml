@{
    ViewBag.Title = "Dashboard";
}

<h2 class="mb-4">Dashboard</h2>

<div class="row">

    <div class="col-md-3">
        <div class="dashboard-card">
            <h6>Total Students</h6>
            <h2>@ViewBag.TotalStudents</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="dashboard-card">
            <h6>Total Courses</h6>
            <h2>@ViewBag.TotalCourses</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="dashboard-card">
            <h6>Total Subjects</h6>
            <h2>@ViewBag.TotalSubjects</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="dashboard-card">
            <h6>Total Marks</h6>
            <h2>@ViewBag.TotalMarks</h2>
        </div>
    </div>

</div>

<div class="row mt-3">

    <div class="col-md-4">
        <div class="dashboard-card">
            <h6>Attendance Records</h6>
            <h2>@ViewBag.TotalAttendance</h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="dashboard-card">
            <h6>Active Students</h6>
            <h2>@ViewBag.ActiveStudents</h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="dashboard-card">
            <h6>Inactive Students</h6>
            <h2>@ViewBag.InactiveStudents</h2>
        </div>
    </div>

</div>

<div class="row mt-4">

    <div class="col-md-6">
        <div class="dashboard-card">
            <h5>Student Statistics</h5>
            <canvas id="studentChart"></canvas>
        </div>
    </div>

    <div class="col-md-6">
        <div class="dashboard-card">
            <h5>Grade Distribution</h5>
            <canvas id="gradeChart"></canvas>
        </div>
    </div>

</div>


@section scripts {

    <script>

    // ==============================
    // Students By Course
    // ==============================

    var courseNames = @Html.Raw(
        Newtonsoft.Json.JsonConvert.SerializeObject(
            ViewBag.CourseNames
        )
    );

    var courseCounts = @Html.Raw(
        Newtonsoft.Json.JsonConvert.SerializeObject(
            ViewBag.CourseStudentCounts
        )
    );

    new Chart(
        document.getElementById('studentChart'),
        {
            type: 'bar',

            data: {
                labels: courseNames,

                datasets: [{
                    label: 'Students',
                    data: courseCounts
                }]
            },

            options: {
                responsive: true,

                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        }
    );


    // ==============================
    // Grade Distribution
    // ==============================

    var grades = @Html.Raw(
        Newtonsoft.Json.JsonConvert.SerializeObject(
            ViewBag.Grades
        )
    );

    var gradeCounts = @Html.Raw(
        Newtonsoft.Json.JsonConvert.SerializeObject(
            ViewBag.GradeCounts
        )
    );

    new Chart(
        document.getElementById('gradeChart'),
        {
            type: 'doughnut',

            data: {
                labels: grades,

                datasets: [{
                    label: 'Students',
                    data: gradeCounts
                }]
            },

            options: {
                responsive: true
            }
        }
        );


        // ==============================
// Attendance Distribution
// ==============================

var presentCount = @ViewBag.PresentCount;

var absentCount = @ViewBag.AbsentCount;

new Chart(
    document.getElementById('attendanceChart'),
    {
        type: 'doughnut',

        data: {
            labels: [
                'Present',
                'Absent'
            ],

            datasets: [{
                label: 'Attendance',

                data: [
                    presentCount,
                    absentCount
                ]
            }]
        },

        options: {
            responsive: true,

            plugins: {
                legend: {
                    position: 'bottom'
                }
            }
        }
    }
);

    </script>

}