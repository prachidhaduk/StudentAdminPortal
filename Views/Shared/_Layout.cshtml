<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - Student Admin Portal</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        body {
            margin: 0;
            background-color: #f5f6fa;
            font-family: Arial, sans-serif;
        }

        /* Sidebar */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: 240px;
            background: #212529;
            padding-top: 20px;
            z-index: 1000;
        }

        .sidebar-brand {
            color: white;
            font-size: 21px;
            font-weight: bold;
            padding: 15px 25px;
            margin-bottom: 20px;
        }

        .sidebar a {
            display: block;
            color: #adb5bd;
            text-decoration: none;
            padding: 13px 25px;
            font-size: 15px;
            transition: 0.2s;
        }

            .sidebar a:hover {
                background: #343a40;
                color: white;
            }

            .sidebar a.active {
                background: #0d6efd;
                color: white;
            }

        /* Main content */
        .main-content {
            margin-left: 240px;
            min-height: 100vh;
        }

        /* Topbar */
        .topbar {
            height: 65px;
            background: white;
            border-bottom: 1px solid #dee2e6;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
        }

        .topbar-title {
            font-size: 20px;
            font-weight: 600;
            color: #343a40;
        }

        .admin-name {
            color: #6c757d;
        }

        /* Page content */
        .page-content {
            padding: 30px;
        }

        /* Cards */
        .dashboard-card {
            background: white;
            border-radius: 10px;
            padding: 22px;
            border: 1px solid #e5e5e5;
            margin-bottom: 20px;
        }

        /* Mobile */
        @@media (max-width: 768px) {

            .sidebar {
                width: 200px;
                margin-left: -200px;
            }

            .main-content {
                margin-left: 0;
            }

            .page-content {
                padding: 15px;
            }
        }
    </style>
</head>

<body>

    <!-- Sidebar -->
    <div class="sidebar">

        <div class="sidebar-brand">
            🎓 Student Admin
        </div>

        <a href="@Url.Action("Index", "Dashboard")">
            🏠 Dashboard
        </a>

        <a href="@Url.Action("Index", "Student")">
            👨‍🎓 Students
        </a>

        <a href="@Url.Action("Index", "Course")">
            📚 Courses
        </a>

        <a href="@Url.Action("Index", "Subject")">
            📖 Subjects
        </a>

        <a href="@Url.Action("Index", "Mark")">
            📝 Marks
        </a>

        <a href="@Url.Action("Index", "Attendance")">
            📅 Attendance
        </a>

        <a href="@Url.Action("Logout", "Account")">
            🚪 Logout
        </a>

    </div>


    <!-- Main Content -->
    <div class="main-content">

        <!-- Top Bar -->
        <div class="topbar">

            <div class="topbar-title">
                @ViewBag.Title
            </div>

            <div class="admin-name">
                👤 @Session["FullName"]
            </div>

        </div>


        <!-- Page Content -->
        <main class="page-content">

            @RenderBody()

        </main>


        <!-- Footer -->
        <footer class="text-center text-muted py-3">
            <hr />
            <p>
                &copy; @DateTime.Now.Year - Student Admin Portal
            </p>
        </footer>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)

</body>
</html>